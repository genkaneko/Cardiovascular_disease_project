# Extended Data Fig. 1a
#   Output: adonis_r2_barplot.svg
#   Bar plot of the variance in gut microbiome composition explained (R2)
#   by each of 10 host covariates. R2 values come from PERMANOVA (adonis2)
#   on Bray-Curtis distances, run separately for each covariate.
#
# Input: beta_diversity_10factor_results.rds, created by Fig2.R.
#        Run Fig2.R first.
#
# Covariate names are renamed for display
# (e.g., "Age" -> "Age>=65", "newHTN" -> "Hypertension").
#
# Required packages: ggplot2, svglite (ggsave() uses it for SVG output)
# Minor edition was made after export

library(ggplot2)

# Load beta diversity results
beta_results <- readRDS("beta_diversity_10factor_results.rds")
names(beta_results)=gsub("Age","Age>=65",names(beta_results))
names(beta_results)=gsub("BMI","BMI>=25",names(beta_results))
names(beta_results)=gsub("newHTN","Hypertension",names(beta_results))
names(beta_results)=gsub("cur.ever.smoking","Smoking",names(beta_results))

# Keep only the metadata variables (the first 10)
vars <- c(
  "Age>=65", "sex", "BMI>=25", "Hypertension", "Smoking",
  "Diabetes.mellitus", "Dyslipidemia", "Alcohol","Antibiotics",
  "Proton.pump.inhibitors"
)

# Extract R2 values
r2_values <- sapply(vars, function(v) beta_results[[v]]$adonis$R2[1])

beta_r2_df <- data.frame(
  Variable = vars,
  R2 = r2_values,
  row.names = NULL
)

# Create a vertical bar plot
beta_r2_df$Variable <- factor(beta_r2_df$Variable, levels = vars)

p_barplot <- ggplot(beta_r2_df, aes(x = Variable, y = R2)) +
  geom_bar(stat = "identity", fill = "black", width = 0.7) +
  theme_minimal() +
  labs(x = "", y = expression(R^2), title = "Adonis R² per Variable") +
  theme(
    axis.text.y = element_text(size = 10),
    axis.text.x = element_text(size = 10, angle = 90, hjust = 1, vjust = 0.5),
    axis.title.x = element_text(size = 10),
    axis.title.y = element_text(size = 10),
    plot.title = element_text(size = 10, hjust = 0.5),
    panel.grid.minor = element_blank()
  )

# Save the bar plot
ggsave("adonis_r2_barplot.svg", 
       plot = p_barplot, 
       width = 2, height = 3, 
       units = "in",
       device = "svg")
